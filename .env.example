# Template tunggal: salin ke .env untuk development maupun production.
# Jangan commit .env. Isi credential sendiri sebelum menjalankan aplikasi.
# Production: APP_ENV=production, CORS_ORIGINS=https://domain-frontend-anda.
APP_ENV=development

# Database eksternal, tidak dijalankan oleh Docker Compose.
# API lokal: 127.0.0.1; API Docker + DB di host: host.docker.internal.
# DB di server lain: gunakan hostname/IP server tersebut.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lmswakafsalman_dev
DB_USER=
# Development: boleh kosong jika akun database memang tanpa password.
# Production: wajib diisi; aplikasi menolak password kosong.
DB_PASSWORD=

# Buat dengan: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# Selalu dinonaktifkan oleh aplikasi pada APP_ENV=production.
ENABLE_DEV_ROUTES=false
FLASK_DEBUG=false
# 1 hanya jika memakai satu reverse proxy tepercaya; selain itu 0.
PROXY_HOPS=0

# Kosong = instance/profile_photos untuk aplikasi lokal.
# Docker selalu memakai /app/instance/profile_photos melalui named volume.
PROFILE_PHOTO_DIR=

# Pengaturan Gunicorn dan Docker.
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
# Production: gunakan tag release/commit unik.
APP_IMAGE=lentera-backend:local
API_PORT=8000
